# AutoShorts Hub - ortam degiskenleri ornegi.
# Bu dosyayi .env olarak kopyalayin ve gercek degerleri girin.
# .env dosyasi Git'e eklemez (gitignore'da).

# --- Zorunlu: PostgreSQL baglantisi ---
# Kalici tum veriler (kanallar, istatistikler, icerikler, yayin planlari) burada tutulur.
DATABASE_URL=postgresql://kullanici:sifre@sunucu:5432/autoshorts_hub

# --- Web arayuzu ---
# Bos birakilirsa giris sorulmaz (yalnizca guvenli yerel ag onerilir).
APP_PASSWORD=

# --- YouTube Data API v3 (istatistik okuma) ---
# Google Cloud Console -> YouTube Data API v3 -> API anahtari olusturun.
YOUTUBE_API_KEY=

# --- YouTube OAuth (video yukleme) ---
# Google Cloud Console -> OAuth istemci kimligi (Web uygulamasi turu).
# Yetkilendirilmis yonlendirme URL'si: http://<pi-adresi>:8080/api/oauth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Zaman ve siklik (opsiyonel) ---
TZ=Europe/Istanbul
# Istatistik toplama dongusu (dakika, min 5).
POLL_INTERVAL_MINUTES=30
# Yayin kuyrugu isleme sikligi (dakika).
PUBLISH_CHECK_INTERVAL_MINUTES=5

# --- Yuklenen dosyalarin klasoru (opsiyonel, varsayilan /data) ---
# DATA_DIR=/data
